{
  "name": "gaokao-volunteer-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:ensure-local": "tsx -r dotenv/config data/scripts/ensure_local_database.ts",
    "data:prepare": "python data/scripts/prepare_collected_anhui_data.py",
    "data:prepare:legacy": "python data/scripts/prepare_week1_2_data.py",
    "data:check": "python data/scripts/check_csv_headers.py",
    "data:validate": "tsx -r dotenv/config data/scripts/validate_week3_data.ts",
    "data:import": "tsx -r dotenv/config data/scripts/import_week3_data.ts",
    "test:data": "tsx tests/collected-data-smoke.ts",
    "test:week4": "tsx tests/week4-rules.ts",
    "test:week5": "tsx tests/week5-recommend.ts",
    "test:week6": "tsx tests/week6-data-guard.ts",
    "test:week7": "tsx tests/week7-volunteer-plan.ts",
    "test:week8": "tsx tests/week8-risk-report.ts",
    "test:week10": "tsx tests/week10-backtest.ts",
    "verify:week4": "npm run check && npm run data:check && npm run data:validate && npm run test:week4",
    "verify:week5": "npm run verify:week4 && npm run test:week5",
    "verify:week6": "npm run verify:week5 && npm run test:week6 && npm run build",
    "verify:week7": "npm run verify:week6 && npm run test:week7",
    "verify:week8": "npm run verify:week7 && npm run test:week8",
    "verify:week9": "npm run verify:week8 && npm run build",
    "verify:week10": "npm run verify:week9 && npm run verify:data && npm run test:week10",
    "vercel-build": "npm run build",
    "verify:data": "npm run data:check && npm run data:validate && npm run test:data",
    "check": "npm run lint && npm run db:validate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "clsx": "^2.1.1",
    "csv-parse": "^6.2.1",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "pdfkit": "^0.18.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
