# 本地开发默认使用本机 PostgreSQL。
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gaokao_volunteer_assistant?schema=public"

# Vercel + Neon 部署时：
# - Vercel 项目环境变量中的 DATABASE_URL 建议使用 Neon pooled connection string。
# - 执行 npm run db:deploy 和 npm run data:import 时，使用 Neon direct connection string 更稳。
# - Neon 连接串通常需要 sslmode=require，以 Neon 控制台提供值为准。

# 只用于标识数据版本，不代表录取承诺。
NEXT_PUBLIC_DATA_VERSION="demo-anhui-2026-plan-v1"

# Required for public POST /api/likes rate limiting.
# Configure these for Development, Preview, and Production in Vercel.
# Do not deploy protected POST writes without both values.
UPSTASH_REDIS_REST_URL="https://your-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-with-upstash-rest-token"
